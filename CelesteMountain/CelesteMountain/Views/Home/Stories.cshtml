@model StoryViewModel
@{
    ViewData["Title"] = "Stories";
}

<h1 class="text-center fw-bolder">Stories Forum</h1>

<form asp-action="Filter" asp-controller="Home" method="get">
    <div class="form-group">
        <label name="poster">Name of poster:</label>
        <input name="poster" class="form-control p-3" /><br />
    </div>
    <div class="form-group">
        <label name="date">Date posted: (mm/dd/yy)</label>
        <input name="date" class="form-control p-3" /><br />
    </div>
    <input type="submit" value="Filter Stories" class="btn btn-info" />
</form>

@foreach (var story in Model.Stories)
{
    <div class="container mt-5">
        <p>@story.Comments.Count</p>
        <h2>@story.Title</h2>
        <h3>@story.Topic</h3>
        <p>@story.Text <br> <div class="container mx-5"> -Circa @story.StoryYear</div></p>
        <p><strong>Posted by:</strong> @if (story.Poster.UserName != null) { <span>@story.Poster.UserName</span>} 
                                        else{<span>anonymous</span>} 
        <div class="fst-italic small m-0"> @story.DatePosted.ToShortDateString()</div></p>
        <br />
        @foreach(Comment comment in story.Comments){
            <br />
            <div class="container ms-5">
            <p>@comment.CommentText</p>
            <p><strong>Posted by:</strong> @if (comment.Commenter.UserName != null) { <span>@comment.Commenter.UserName</span>} 
                                        else{<span>anonymous</span>}
                    <div class="fst-italic small m-0"> @comment.DatePosted.ToShortDateString()</div>
                </p>
            </div>
        }
        <a asp-action="PostComment" asp-route-storyId="@story.StoryPostId" class="btn btn-outline-info">Post Comment</a>
    </div>
}

<div class="container mt-lg-5">
    <a href="@Url.Action("PostStory", "Home")" class="btn btn-info">Contribute Your Story</a>
</div>